# Kopieren nach .env und anpassen. .env niemals einchecken.
DOMAIN=raeume.example.org
SITE_URL=https://raeume.example.org
SITE_NAME=Veedelsräume
DJANGO_SECRET_KEY=bitte-durch-langen-zufallswert-ersetzen
DJANGO_ALLOWED_HOSTS=raeume.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://raeume.example.org
POSTGRES_PASSWORD=bitte-aendern

# E-Mail (Anbieter in der EU mit AV-Vertrag)
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=kontakt@raeume.example.org
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Veedelsräume <kontakt@raeume.example.org>

# Gruppen nach E-Mail-Bestätigung zusätzlich von Hand freischalten?
GROUP_MANUAL_APPROVAL=false

# Löschfristen in Tagen
RETENTION_UNVERIFIED_ACCOUNTS_DAYS=7
RETENTION_UNCONFIRMED_SUBMISSIONS_DAYS=14
LISTING_REQUEST_VALIDITY_DAYS=90
RETENTION_INACTIVE_ACCOUNTS_DAYS=730
MAX_LISTING_REQUESTS=2
